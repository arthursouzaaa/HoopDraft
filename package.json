{
  "name": "hoopdraft",
  "productName": "HoopDraft",
  "version": "0.1.0",
  "private": true,
  "description": "NBA draft & playoff simulator",
  "author": "Seu Nome",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "fetch-data": "node scripts/fetch-data.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "framer-motion": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.5",
    "vitest": "^2.0.5",
    "wait-on": "^7.2.0"
  }
}